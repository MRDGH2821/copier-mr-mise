amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // Secrets
  ["betterleaks"] = Builtins.betterleaks
  ["detect-private-key"] = Builtins.detect_private_key

  // Config Files
  ["pkl"] = Builtins.pkl
  ["pkl_format"] = Builtins.pkl_format
  ["gitignore-tidy"] {
    check = "gitignore-tidy {{files}}"
    fix = "gitignore-tidy {{files}}"
    glob = List("**/.*ignore", ".*ignore")
  }
  ["tombi"] = Builtins.tombi
  ["tombi_format"] = (Builtins.tombi_format) { depends = List("toml-sort") }
  ["toml-sort"] {
    check = "toml-sort --check --sort-table-keys --sort-inline-tables {{files}}"
    exclude = List("tombi.toml")
    fix = "toml-sort --in-place --sort-table-keys --sort-inline-tables {{files}}"
    types = List("toml")
  }

  // Misc
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_shebang_scripts_are_executable"] = Builtins.check_shebang_scripts_are_executable
  ["check-placeholders"] {
    check =
      "if grep -EIn '(<placeholder>|CHANGEME|FILL_ME_IN|NOCOMMIT)' {{files}}; then false; else test $? -eq 1; fi"
    exclude = List("template/**", ".config/hk.pkl", ".config/cspell.json")
  }
  ["keep-sorted"] {
    check = "keep-sorted --mode lint {{files}}"
    fix = "keep-sorted --mode fix {{files}}"
  }
  ["ls_lint"] = Builtins.ls_lint
  ["mise"] = Builtins.mise

  // Python
  ["ruff"] = Builtins.ruff
  ["ruff_format"] = Builtins.ruff_format

  // Text
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
  ["rumdl"] = (Builtins.rumdl) { depends = List("rumdl-format") }
  ["rumdl_format"] = Builtins.rumdl_format
  ["ryl"] = Builtins.ryl
  ["ryl_markdown"] = Builtins.ryl_markdown
  ["sort-markdown-tables"] {
    check = "smt --check {{files}}"
    fix = "smt --in-place {{files}}"
    types = List("markdown")
  }

  // Style Files
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["mixed_line_ending"] = Builtins.mixed_line_ending

  // AIO
  ["oxfmt"] = Builtins.oxfmt

  // Spell Check
  ["cspell"] {
    check = "cspell --no-must-find-files --no-progress --no-summary --gitignore --files {{files}}"
  }
  ["typos"] = Builtins.typos
}
exclude =
  List(
    // keep-sorted start
    "**/*.lock",
    "**/.mise/**",
    "**/go.sum",
    "**/locks/**",
    "**/npm-shrinkwrap.json",
    "**/package-lock.json",
    "**/pnpm-lock.yaml"
    // keep-sorted end
  )
steps = linters

hooks {
  ["pre-push"] {
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["check_conventional_commit"] = Builtins.check_conventional_commit
      ["cocogitto_commit_msg"] = Builtins.cocogitto_commit_msg
      ["cspell"] {
        check =
          "cspell --no-must-find-files --no-progress --no-summary --gitignore --files {{commit_msg_file}}"
      }
      ["typos"] = Builtins.typos
    }
  }
}
