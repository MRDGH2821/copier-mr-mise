author: MRDGH2821
dependencies:
  apm:
    - git: vercel-labs/skills
      ref: v1.5.20
      skills:
        - find-skills
    - git: github/awesome-copilot
      skills:
        - git-commit
    - git: kucherenko/jscpd
      ref: v5.0.12
      skills:
        - dry-refactoring
    {% if use_taste_skill %}
    - git: Leonxlnx/taste-skill
    {% endif %}
  mcp:
      - args:
          - mcp
        command: mise
        name: mise
        registry: false
        transport: stdio
      - args:
          - mcp
          - root
          - .
        command: hk
        name: hk
        registry: false
        transport: stdio
includes: auto
name: {{ project_name }}
scripts: {}
targets:
  - agent-skills
  - antigravity
  - copilot
  - cursor
  - opencode
version: 0.0.0
