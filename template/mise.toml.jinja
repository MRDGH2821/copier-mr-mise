[env]
HK_MISE = 1

[hooks]
# Automatically install/update hooks when tools are installed
postinstall = ["hk install --mise"]

[settings]
lockfile = true

[settings.github]
use_git_credentials = true

[tasks]
ai-setup = "capa install --yes"
check = ["hk check --all", "cog check"]
prepare = ["bun install"]

[tasks.format]
alias = "fmt"
run = [{ task = "treefmt" }, "hk fix --all"]

[tasks.treefmt]
run = "treefmt"
run_windows = "echo 'Treefmt not supported on Windows'"

[tools]
"aqua:google/keep-sorted" = "0.10.0"
"aqua:numtide/treefmt" = { os = ["linux", "macos"], version = "2.6.0" }
"aqua:owenlamont/ryl" = "0.24.0"
betterleaks = "1.9.0"
bun = { postinstall = "bun install", version = "1.4.3" }
cocogitto = "7.0.0"
cspell = "10.3.6"
editorconfig-checker = "4.0.2"
{% if ci == 'github' %}
gh = "2.102.0"
{% endif %}
git-cliff = "2.14.2"
{% if ci == 'gitlab' %}
glab = { postinstall = "glab auth login", version = "1.122.0" }
{% endif %}
"github:MRDGH2821/Sort-Markdown-Tables" = "0.5.0"
"github:infragate/capa" = { postinstall = "capa install --yes", version = "2.2.4" }
hk = "2.5.0"
ls-lint = "2.3.1"
oxfmt = "0.72.0"
"pipx:lorenzwalthert/gitignore-tidy" = "latest"
"pipx:toml-sort" = "0.25.0"
"pipx:yamlfix" = "1.19.1"
pkl = "0.32.1"
ruff = "0.17.0"
rumdl = "0.2.79"
tombi = "1.8.0"
typos = "1.51.1"
typstyle = "0.15.1"
uv = "0.13.0"
yq = "4.54.1"

[[watch_files]]
patterns = ["capabilities.yaml"]
task = "ai-setup"
