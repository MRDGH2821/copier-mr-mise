[deps.bun]
auto = true

{% if use_ai %}
[deps.capabilities]
auto = true
description = "Install Agent plugins"
# tombi: format.rules.array-values-order = "ascending"
outputs = [
  ".agents/skills/",
  ".claude/",
  ".codex/",
  ".cursor/",
  ".kiro/",
  ".mcp.json",
  "capabilities.lock",
  "opencode.json"
]
run = "capa install --yes"
# tombi: format.rules.array-values-order = "ascending"
sources = [
  ".config/capabilities/",
  "capabilities.yaml",
  "template/.config/capabilities/"
]
{% endif %}

[env]
HK_MISE = 1

[hooks]
# Automatically install/update git hooks when tools are installed.
{%- if use_ai %}
# Then reconcile agent capabilities — capa is installed as a mise tool, so it
# is guaranteed present by the time postinstall runs.
{%- endif %}
postinstall = ["hk install --mise"{% if use_ai %}, { task = "ai-setup" }{% endif %}]

[settings]
experimental = true
lockfile = true
lockfile_auto_prune = true

[settings.github]
use_git_credentials = true

[tasks]
{% if use_ai %}
ai-setup = "capa install --yes"
{% endif %}
check = ["hk check --all", "cog check"]
prepare-ci = ["bun ci"]

[tasks.format]
alias = "fmt"
run = ["hk fix --all"]

[tasks.prepare]
interactive = true
run = ["bun install"{% if use_ai %}, { task = "ai-setup" }{% endif %}]

[tools]
"aqua:google/keep-sorted" = "0.10.0"
"aqua:owenlamont/ryl" = "0.29.0"
betterleaks = "1.10.0"
bun = "1.4.4"
cocogitto = "7.0.0"
cspell = "10.4.0"
editorconfig-checker = "4.0.2"
{% if ci == "forgejo" %}
"forgejo:forgejo-contrib/forgejo-cli" = "0.7.0"
{% endif %}
{% if ci == 'github' %}
gh = "2.103.3"
{% endif %}
git-cliff = "2.14.2"
{% if ci == 'gitlab' %}
glab = "1.127.0"
{% endif %}
"github:MRDGH2821/Sort-Markdown-Tables" = "0.6.0"
{% if use_taste_skill %}
"npm:@google/design.md" = "0.4.0"
{% endif %}
{% if use_ai %}
"github:infragate/capa" = "2.4.0"
{% endif %}
hk = { version = "2.11.1", workflow = "release.yml" }
ls-lint = "2.3.2"
oxfmt = "0.76.0"
pkl = "0.33.0"
"pypi:lorenzwalthert/gitignore-tidy" = "latest"
"pypi:toml-sort" = "0.25.0"
python = "latest"
rumdl = "0.3.2"
tombi = "1.10.0"
typos = "1.52.0"
uv = "0.13.7"
yq = "4.54.2"
