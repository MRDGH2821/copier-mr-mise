[deps.bun]
auto = true

{% if use_ai %}
[deps.capabilities]
description = "Install Agent plugins"
outputs = [
  "capabilities.lock",
  ".agents/skills/",
  ".codex/skills/",
  ".claude/skills/",
  ".cursor/skills/",
  ".mcp.json",
  "opencode.json"
]
run = "capa install --yes"
# tombi: format.rules.array-values-order = "ascending"
sources = [
  ".config/capabilities/",
  "capabilities.yaml"
]
{% endif %}

[env]
HK_MISE = 1

[hooks]
# Automatically install/update hooks when tools are installed
postinstall = ["hk install --mise"]

[settings]
experimental = true
lockfile = true
lockfile_auto_prune = true

[settings.github]
use_git_credentials = true

[tasks]
{% if use_ai %}
ai-setup = "capa install --yes"
{% endif %}
check = ["hk check --all", "cog check"]
prepare-ci = ["bun ci"]

[tasks.format]
alias = "fmt"
run = ["hk fix --all"]

[tasks.prepare]
interactive = true
run = ["bun install",
{% if use_ai %}
{ task = "ai-setup" }
{% endif %}
]

[tools]
"aqua:google/keep-sorted" = "0.10.0"
"aqua:owenlamont/ryl" = "0.26.1"
betterleaks = "1.9.0"
bun = "1.4.4"
cocogitto = "7.0.0"
cspell = "10.4.0"
editorconfig-checker = "4.0.2"
{% if ci == "forgejo" %}
"forgejo:forgejo-contrib/forgejo-cli" = "0.7.0"
{% endif %}
{% if ci == 'github' %}
gh = "2.103.3"
{% endif %}
git-cliff = "2.14.2"
{% if ci == 'gitlab' %}
glab = "1.126.0"
{% endif %}
"github:MRDGH2821/Sort-Markdown-Tables" = "0.6.0"
{% if use_ai %}
"github:infragate/capa" = "2.4.0"
{% endif %}
hk = { version = "2.9.0", workflow = "release.yml" }
ls-lint = "2.3.2"
oxfmt = "0.75.0"
"pipx:lorenzwalthert/gitignore-tidy" = "latest"
"pipx:toml-sort" = "0.25.0"
pkl = "0.32.2"
ruff = "0.17.3"
rumdl = "0.3.2"
tombi = "1.9.7"
typos = "1.51.1"
uv = "0.13.6"
yq = "4.54.1"
