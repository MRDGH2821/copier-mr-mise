{
  "allowCompoundWords": true,
  "caseSensitive": false,
  "ignorePaths": [
    "**/.git/**",
    "**/.pnpm-lock.json",
    "**/bin/mise",
    "**/node_modules/**",
    "**/vscode-extension/**",
    ".mise",
    ".vscode",
    ".zed",
    "apm.lock.yaml",
    "megalinter",
    "megalinter-reports",
    "package-lock.json",
    "report"
  ],
  "language": "en,en-GB",
  "noConfigSearch": true,
  "useGitignore": true,
  "version": "0.2",
  "words": [
    "artipacked",
    "bunx",
    "capa",
    "Capify",
    "cocogitto",
    "devenv",
    "direnv",
    "dotenv",
    "esac",
    "glab",
    "Leonxlnx",
    "lorenzwalthert",
    "mattpocock",
    "MRDGH",
    "nixpkgs",
    "numtide",
    "obra",
    "otbs",
    "paad",
    "pipx",
    "pycache",
    "pytest",
    "rumdl",
    "stefanzweifel",
    "Tera",
    "tombi",
    "topo",
    "treefmt",
    "venv",
    "yamlfix",
    "zizmor"
  ]
}
